{
  "schema": "aibenchie.universal-e2e.manifest.v1",
  "id": "echolabs-suite",
  "name": "EchoLabs Suite",
  "lanes": {
    "api": {
      "name": "EchoLabs API E2E",
      "type": "api",
      "targets": [
        {
          "id": "hosted-backend",
          "name": "Hosted or local backend",
          "type": "http",
          "adapter": "http",
          "base_url": "${ENV:AIBENCHIE_BACKEND_URL:-}",
          "required": false,
          "timeout_seconds": 10,
          "checks": [
            {
              "id": "health",
              "path": "/health",
              "expect_status": 200
            },
            {
              "id": "aibenchie-greeting",
              "path": "/api/aibenchie/greeting",
              "expect_status": 200,
              "expect_json": {
                "ok": true,
                "contract": "aibenchie.frontend-backend.v1"
              }
            }
          ]
        },
        {
          "id": "bridgeecho-api",
          "name": "BridgeEcho API and trust fabric",
          "type": "api",
          "adapter": "command",
          "required": true,
          "cwd": "${ENV:AIBENCHIE_ECHOLABS_BRIDGE_ROOT:-../../NullBridge/backend}",
          "command": ["powershell", "-ExecutionPolicy", "Bypass", "-File", "scripts/nullbridge_release_gate.ps1"],
          "timeout_seconds": 420,
          "notes": "Runs BridgeEcho/NullBridge API, service identity, approval routing, signed-envelope, and redaction gates."
        }
      ]
    },
    "ux": {
      "name": "EchoLabs UX E2E",
      "type": "ux",
      "targets": [
        {
          "id": "web-ux",
          "name": "Web user workflow",
          "type": "web",
          "adapter": "command",
          "required": true,
          "cwd": "${ENV:AIBENCHIE_ECHOLABS_WEB_ROOT:-../../.NullXoid}",
          "command": ["npm", "run", "verify:nullxoid"],
          "timeout_seconds": 240,
          "notes": "Runs the EchoLabs web shell build and NullXoid UI contract checks until the browser-driven Playwright adapter is promoted."
        },
        {
          "id": "web-browser-ux",
          "name": "Web browser workflow",
          "type": "web",
          "adapter": "web_browser",
          "required": true,
          "retries": 1,
          "cwd": "${ENV:AIBENCHIE_ECHOLABS_WEB_ROOT:-../../.NullXoid}",
          "env": {
            "VITE_NULLXOID_EMBED_LOCAL_APP": "true"
          },
          "build_command": ["npm", "run", "build"],
          "build_timeout_seconds": 240,
          "serve_dir": "dist",
          "path": "/nullxoid",
          "timeout_seconds": 30,
          "evidence_dir": "${ENV:AIBENCHIE_ECHOLABS_BROWSER_EVIDENCE:-../_validation/universal-e2e/web-browser-ux}",
          "mock_routes": [
            {
              "method": "GET",
              "path": "/auth/me",
              "body": {
                "authenticated": true,
                "require_login": false,
                "user": { "id": "aibenchie-user", "username": "AIBenchie", "role": "admin" },
                "effective_features": {
                  "addons": ["ccc.codex", "canvas.preview", "studioecho.media"],
                  "admin": true,
                  "chat": true,
                  "media": true
                },
                "first_run_state": { "mode": "complete", "source": "aibenchie" }
              }
            },
            {
              "method": "GET",
              "path": "/health/features",
              "body": {
                "ok": true,
                "features": {
                  "auth": true,
                  "chat_stream": true,
                  "settings_enabled": true,
                  "runtimeecho_llms": true,
                  "vault_artifacts": true
                },
                "endpoints": [
                  "/auth/me",
                  "/chat/stream",
                  "/models",
                  "/api/settings",
                  "/api/workspaces",
                  "/api/projects",
                  "/api/chats",
                  "/artifacts/recent"
                ],
                "first_run_state": { "mode": "complete", "source": "aibenchie" }
              }
            },
            {
              "method": "GET",
              "path": "/models",
              "body": { "models": [{ "id": "llama3.1:8b", "name": "llama3.1:8b", "provider": "ollama" }] }
            },
            {
              "method": "GET",
              "path": "/api/settings",
              "body": {
                "settings": {
                  "general": { "assistant_name": "NullXoid" },
                  "llm": {
                    "default_model": "llama3.1:8b",
                    "router_model": "llama3.1:8b",
                    "heavy_model": "llama3.1:8b"
                  },
                  "voice": { "stt_provider": "browser", "tts_provider": "browser" }
                },
                "defaults": {
                  "general": { "assistant_name": "NullXoid" },
                  "llm": {
                    "default_model": "llama3.1:8b",
                    "router_model": "llama3.1:8b",
                    "heavy_model": "llama3.1:8b"
                  },
                  "voice": { "stt_provider": "browser", "tts_provider": "browser" }
                },
                "meta": { "source": "aibenchie" }
              }
            },
            {
              "method": "GET",
              "path": "/api/workspaces",
              "body": {
                "active_workspace_id": "lobby",
                "workspaces": [
                  { "workspace_id": "lobby", "name": "Lobby", "slug": "lobby", "is_system": true }
                ]
              }
            },
            {
              "method": "GET",
              "path": "/api/projects",
              "body": {
                "projects": [
                  { "project_id": "general", "workspace_id": "lobby", "name": "General", "slug": "general", "is_system": true }
                ]
              }
            },
            {
              "method": "GET",
              "path": "/api/chats",
              "body": { "chats": [] }
            },
            {
              "method": "POST",
              "path": "/api/chats",
              "body": {
                "chat": {
                  "id": "aibenchie-chat",
                  "chat_id": "aibenchie-chat",
                  "title": "AIBenchie browser chat smoke",
                  "workspace_id": "lobby",
                  "project_id": "general",
                  "messages": []
                }
              }
            },
            {
              "method": "GET",
              "path": "/artifacts/recent",
              "body": { "artifacts": [] }
            },
            {
              "method": "GET",
              "path": "/api/jobs/active",
              "body": { "jobs": [] }
            },
            {
              "method": "GET",
              "path": "/api/notifications",
              "body": { "notifications": [] }
            },
            {
              "method": "GET",
              "path": "/api/workflows",
              "body": { "workflows": [] }
            },
            {
              "method": "POST",
              "path": "/chat/stream",
              "content_type": "text/event-stream",
              "body": "event: status\ndata: {\"state\":\"started\"}\n\nevent: token\ndata: {\"delta\":\"AIBenchie browser mock response\"}\n\nevent: done\ndata: {\"ok\":true}\n\n"
            }
          ],
          "expect": [
            { "text": "NullXoid" },
            { "selector": "textarea[placeholder='Ask anything']", "timeout_ms": 30000 }
          ],
          "flow": [
            { "action": "expect_selector", "selector": "textarea[placeholder='Ask anything']", "timeout_ms": 30000 },
            { "action": "fill", "selector": "textarea[placeholder='Ask anything']", "value": "Run AIBenchie browser chat smoke.", "timeout_ms": 10000 },
            { "action": "click_selector", "selector": "button[aria-label='Send']", "timeout_ms": 10000 },
            { "action": "expect_text", "text": "AIBenchie browser mock response", "timeout_ms": 30000 },
            { "action": "goto", "path": "/aibenchie", "timeout_ms": 30000 },
            { "action": "expect_text", "text": "Release evidence" },
            { "action": "expect_text", "text": "Deploy add-on" },
            { "action": "screenshot", "name": "release-evidence" }
          ],
          "notes": "Release-blocking Playwright-style browser workflow. Captures screenshot, HTML, and trace evidence. Runner setup must install the Playwright Python package and Chromium browser."
        },
        {
          "id": "android-ux",
          "name": "Android user workflow",
          "type": "android",
          "adapter": "command",
          "required": true,
          "cwd": "${ENV:AIBENCHIE_ECHOLABS_ANDROID_ROOT:-../../NullXoidAndroid}",
          "command": ["powershell", "-ExecutionPolicy", "Bypass", "-File", "scripts/android_release_gate.ps1"],
          "timeout_seconds": 420,
          "notes": "Runs Android unit contracts and debug APK build until the ADB/instrumentation user workflow is promoted."
        },
        {
          "id": "android-onboarding-e2e",
          "name": "Android onboarding setup workflow",
          "type": "android",
          "adapter": "command",
          "required": true,
          "cwd": "..",
          "command": [
            "python",
            "aibenchie_local.py",
            "--android-onboarding-e2e",
            "--android-onboarding-repo",
            "${ENV:AIBENCHIE_ECHOLABS_ANDROID_ROOT:-../NullXoidAndroid}",
            "--json"
          ],
          "timeout_seconds": 120,
          "notes": "Release-blocking AIBenchie onboarding setup QR/deep-link contract. Keeps QR setup additive beside manual setup and preserves OIDC callbacks."
        },
        {
          "id": "desktop-ux",
          "name": "Desktop user workflow",
          "type": "desktop",
          "adapter": "command",
          "required": true,
          "retries": 1,
          "cwd": "${ENV:AIBENCHIE_ECHOLABS_DESKTOP_ROOT:-../../AiAssistant}",
          "command": ["powershell", "-ExecutionPolicy", "Bypass", "-File", "scripts/desktop_release_gate.ps1"],
          "timeout_seconds": 900,
          "notes": "Runs desktop model-policy, unit, bridge, and smoke gates until native desktop automation is promoted."
        }
      ]
    }
  }
}
